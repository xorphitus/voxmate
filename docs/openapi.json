{
  "openapi": "3.1.0",
  "info": {
    "title": "voxmate Local API",
    "description": "Make the voxmate avatar speak. Listens on 127.0.0.1 only (port 50080 by default, configurable in the app). Every request needs a loopback `Host` header (`127.0.0.1`, `localhost` or `[::1]`). CORS preflights are never answered, so web pages on other origins cannot call it.",
    "contact": {
      "name": "xorphitus"
    },
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:50080",
      "description": "Default port"
    }
  ],
  "paths": {
    "/audio_query": {
      "post": {
        "tags": [],
        "summary": "Make a VOICEVOX `audio_query` to edit.",
        "description": "Returns the engine's query for the text, unchanged. Edit it and send it\nback as `audioQuery` in `POST /speak`, so clients need not know the\nengine's URL.",
        "operationId": "audio_query",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AudioQueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The engine's `audio_query`",
            "content": {
              "application/json": {}
            }
          },
          "400": {
            "description": "Blank or too long text, a malformed character id, or malformed JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "`Host` is not a loopback name",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "No character with that id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "413": {
            "description": "Body larger than 1 MiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "415": {
            "description": "Content type is not `application/json`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "JSON does not match `AudioQueryRequest`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "502": {
            "description": "The VOICEVOX engine is unreachable or failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [],
        "summary": "Check that voxmate is running.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "403": {
            "description": "`Host` is not a loopback name",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": [],
        "summary": "This OpenAPI document.",
        "operationId": "openapi_json",
        "responses": {
          "200": {
            "description": "OpenAPI document",
            "content": {
              "application/json": {}
            }
          },
          "403": {
            "description": "`Host` is not a loopback name",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/speak": {
      "post": {
        "tags": [],
        "summary": "Queue text for the avatar to speak.",
        "description": "Requests from the API and the app share one queue, so utterances never\noverlap. The response is sent as soon as the text is queued.",
        "operationId": "speak",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpeakRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Queued (not yet spoken)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpeakAccepted"
                }
              }
            }
          },
          "400": {
            "description": "Blank or too long text, a malformed character id, an out-of-range voice parameter, an `audioQuery` without `accent_phrases`, or malformed JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "`Host` is not a loopback name",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "413": {
            "description": "Body larger than 1 MiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "415": {
            "description": "Content type is not `application/json`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "JSON does not match `SpeakRequest`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Human-readable reason.",
            "example": "text must not be empty"
          }
        }
      },
      "AudioQueryRequest": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "description": "Text to make a query for, 1 to 2000 characters after trimming.",
            "example": "こんにちは",
            "maxLength": 2000,
            "minLength": 1
          },
          "character": {
            "type": [
              "string",
              "null"
            ],
            "description": "Character whose speaker to use. Omit both this and `speaker` to use the\ncharacter on stage.",
            "example": "default",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "speaker": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "VOICEVOX style id; wins over `character`.",
            "example": 3,
            "minimum": 0
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "ok",
          "name",
          "version"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "name": {
            "type": "string",
            "example": "voxmate"
          },
          "version": {
            "type": "string",
            "description": "voxmate version.",
            "example": "0.1.0"
          }
        }
      },
      "SpeakAccepted": {
        "type": "object",
        "description": "The text was queued. It is spoken after anything already in the queue,\nso this does not mean it has been spoken.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/SpeakStatus"
          }
        }
      },
      "SpeakRequest": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Text to speak. Leading and trailing whitespace is trimmed, and the\ntrimmed text must be 1 to 2000 characters (Unicode scalar values).\nWith `audioQuery` it is what the conversation log shows; it may then be\nomitted, and the query's `kana` is used instead.",
            "example": "こんにちは",
            "maxLength": 2000
          },
          "character": {
            "type": [
              "string",
              "null"
            ],
            "description": "Id of the character who speaks, as shown in the app's character\nsettings. Omit it to use the character on stage. An id the app doesn't\nknow is accepted here and reported as an error in the app.",
            "example": "default",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "speaker": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "VOICEVOX style id (`GET /speakers` on the engine). Overrides the\ncharacter's voice. Omit it to use the character's speaker.",
            "example": 3,
            "minimum": 0
          },
          "voice": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/VoiceParams",
                "description": "How the line sounds. Each field overrides the character's default,\nwhich overrides the engine's. With `audioQuery`, it overrides the\nquery's values and the character's defaults are not applied.\nOut-of-range values are rejected."
              },
              {
                "type": "null"
              }
            ]
          },
          "audioQuery": {
            "type": [
              "object",
              "null"
            ],
            "description": "A complete VOICEVOX `audio_query` (e.g. from `POST /audio_query`,\nedited) to synthesize as is, for control over accents, mora pitch and\nlength, and pauses. Pitch values belong to the speaker the query was\nmade for; another speaker works but sounds off. The engine's\nvalidation errors are reported in the app, as a failed line."
          }
        }
      },
      "SpeakStatus": {
        "type": "string",
        "enum": [
          "queued"
        ]
      },
      "VoiceParams": {
        "type": "object",
        "description": "How a line sounds. Each field overrides one `audio_query` value; omitted\nfields keep what the engine chose. Ranges are those of the VOICEVOX editor.",
        "properties": {
          "speed": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "`speedScale`, 0.5 to 2.",
            "example": 1.2,
            "maximum": 2,
            "minimum": 0.5
          },
          "pitch": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "`pitchScale`, -0.15 to 0.15.",
            "maximum": 0.15,
            "minimum": -0.15
          },
          "intonation": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "`intonationScale`, 0 to 2.",
            "maximum": 2,
            "minimum": 0
          },
          "volume": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "`volumeScale`, 0 to 2. The app volume applies on top.",
            "maximum": 2,
            "minimum": 0
          },
          "prePhonemeLength": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Silence before the line in seconds, 0 to 1.5.",
            "maximum": 1.5,
            "minimum": 0
          },
          "postPhonemeLength": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Silence after the line in seconds, 0 to 1.5.",
            "maximum": 1.5,
            "minimum": 0
          },
          "pauseLengthScale": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Multiplies pauses between phrases, 0 to 2 (newer engines only).",
            "maximum": 2,
            "minimum": 0
          }
        }
      }
    }
  }
}
